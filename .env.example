# --- required ---
MONGO_URI=mongodb://127.0.0.1:27017/taskmanager
JWT_SECRET=change-me

# Registration PINs. A signup sending this value as `adminInviteToken` gets that
# role; leave one unset and no-one can self-register into it.
ADMIN_INVITE_TOKEN=
HEAD_INVITE_TOKEN=
PORT=8000

# Used in notification emails to link back to a task.
CLIENT_URL=http://localhost:5173

# --- email notifications (optional) ---
# Leave SMTP_HOST/SMTP_USER unset and every email send becomes a silent no-op;
# in-app and real-time notifications still work.
#
# Any SMTP server works. For the self-hosted Stalwart relay see deploy/mail/README.md,
# which binds it to 127.0.0.1:587 so nothing new is exposed to the internet.
# Alerts are sent from MAIL_FROM but carry the acting user name in the From display
# name and their address in Reply-To, so a reply reaches a person rather than a bot.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- deadline reminders (optional) ---
# How far ahead a task counts as "due soon", and how often the scan runs.
REMINDER_WINDOW_HOURS=24
REMINDER_INTERVAL_MINUTES=15
