# --- required ---
MONGO_URI=mongodb://127.0.0.1:27017/taskmanager
JWT_SECRET=change-me

# Registration PINs. A signup sending this value as `adminInviteToken` gets that
# role; leave one unset and no-one can self-register into it.
ADMIN_INVITE_TOKEN=
HEAD_INVITE_TOKEN=
PORT=8000

# Used in notification messages to link back to a task.
CLIENT_URL=http://localhost:5173

# --- WhatsApp notifications (optional) ---
# Alerts go out over a self-hosted Blastup gateway. Leave either value unset and
# every send is a silent no-op; in-app and real-time notifications still work.
# See deploy/whatsapp/README.md for standing the gateway up.
BLASTUP_URL=http://127.0.0.1:3001
BLASTUP_API_KEY=

# Country code applied to a bare local number a member types into their profile.
DEFAULT_COUNTRY_CODE=91

# --- deadline reminders (optional) ---
# How far ahead a task counts as "due soon", and how often the scan runs.
REMINDER_WINDOW_HOURS=24
REMINDER_INTERVAL_MINUTES=15

# Days overdue before department heads and the task creator are alerted (default 2)
ESCALATE_AFTER_DAYS=2

# --- security / hosting ---
# Browser origins allowed to call the API cross-origin (comma separated). Leave
# empty when the web app is served by this server (same origin). Needed for e.g. a
# separate Vite dev server: CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
# Set true once the site is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# --- file storage ---
# local (default, server/uploads) or s3 (AWS S3, MinIO, Cloudflare R2).
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=              # MinIO / R2 endpoint
# S3_FORCE_PATH_STYLE=true  # MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Open self-signup as a member (off by default). The first account on an empty
# database always becomes the admin; after that, admins create accounts on the Team page.
ALLOW_SIGNUP=false
