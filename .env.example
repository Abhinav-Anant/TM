# --- required ---
MONGO_URI=mongodb://127.0.0.1:27017/taskmanager
JWT_SECRET=change-me
PORT=8000

# Used in notification emails to link back to a task.
CLIENT_URL=http://localhost:5173

# --- email notifications (optional) ---
# Leave SMTP_HOST/SMTP_USER unset and every email send becomes a silent no-op;
# in-app and real-time notifications still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- deadline reminders (optional) ---
# How far ahead a task counts as "due soon", and how often the scan runs.
REMINDER_WINDOW_HOURS=24
REMINDER_INTERVAL_MINUTES=15
