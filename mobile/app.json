{
  "expo": {
    "name": "Task Manager",
    "slug": "task-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.taskmanager.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "http://localhost:8000"
    },
    "plugins": [
      "expo-asset",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Task Manager to use the camera so you can attach photos to tasks.",
          "photosPermission": "Allow Task Manager to read your photos so you can attach them to tasks."
        }
      ]
    ]
  }
}
